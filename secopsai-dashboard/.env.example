# SecOpsAI dashboard local environment
# Copy to .env and fill in real values.

SUPABASE_URL=https://wjxvdjsatfepfcbxunfs.supabase.co
SUPABASE_ANON_KEY=replace_me
APP_NAME="SecOpsAI Triage Dashboard"
DASHBOARD_AUTH_REQUIRED=true
# Every local API request requires this independent bearer token, including
# loopback requests. Paste the same value into System > Credentials after the
# dashboard loads. It is never generated into config.js or sent to hosted
# services.
DASHBOARD_LOCAL_AUTH_TOKEN=generate-a-long-random-value
SECOPSAI_ROOT=/Users/chrixchange/secopsai
SECOPSAI_EDGE_API_URL=https://secopsai-edge-api.onrender.com
SECOPSAI_EDGE_OPERATIONS_TOKEN=replace_me_server_side_only
# Deprecated migration fallback only. Prefer the scoped operations token above.
SECOPSAI_EDGE_ADMIN_TOKEN=
SECOPSAI_EDGE_DASHBOARD_URL=
INTELLIGENCE_ADMIN_TOKEN=replace_me_server_side_only

# Optional Tria.ge Researcher API token. Keep it server-side; the browser only
# sees whether the provider is configured. Public submissions remain
# approval-gated and visible publicly on Tria.ge.
TRIAGE_API_TOKEN=
